# Production MySQL/MariaDB Configuration Template
# Optimized for production database performance and reliability

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4

[mysqld]
# Basic settings
user = mysql
bind-address = 0.0.0.0
default-storage-engine = InnoDB

# Character sets & Collations
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# Fine Tuning
max_connections = 200
connect_timeout = 10
wait_timeout = 28800
interactive_timeout = 28800
max_allowed_packet = 64M
thread_cache_size = 32
sort_buffer_size = 4M
bulk_insert_buffer_size = 16M
tmp_table_size = 64M
max_heap_table_size = 64M

# InnoDB Tuning (Production-grade)
# In production, set innodb_buffer_pool_size to 50% - 70% of available RAM.
# We default to 1G here as a safe starting point.
innodb_buffer_pool_size = 1G
innodb_buffer_pool_instances = 1
innodb_log_file_size = 256M
innodb_log_buffer_size = 16M

# Durability & Performance
# 1 = Full ACID compliance (flushes to disk on every commit - safest)
# 2 = Flushes to OS cache every commit, written to disk every second (highly performant, risk of 1-second data loss on power failure)
innodb_flush_log_at_trx_commit = 1
innodb_flush_method = O_DIRECT
innodb_lock_wait_timeout = 50
innodb_doublewrite = 1

# Logging Settings
# Note: Log files must exist or the directory must be writable by the mysql user (UID/GID 999)
log_error = /var/log/mysql/error.log

# Binary Logging for Disaster Recovery & Point-in-Time Recovery (PITR)
server-id = 1
log_bin = /var/log/mysql/mariadb-bin
binlog_format = ROW
expire_logs_days = 7
max_binlog_size = 100M
sync_binlog = 1

# Slow Query Log
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 2
log_queries_not_using_indexes = 0

