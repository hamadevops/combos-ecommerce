# --- DATABASE AND CACHE DOCKER ENVIRONMENT ---
# Copy this file to .env and customize values for production deployment.
# Note: Since network_mode: host is active, these services bind directly to the host network interface.

# Container image versions
MARIADB_VERSION=10.11
REDIS_VERSION=7.2

# Network Host Port Bindings
# (Ensure these ports are open in the firewall and not in use by other services on the host)
DB_PORT=3306
REDIS_PORT=6379

# MariaDB Credentials
DB_ROOT_PASSWORD=change_this_to_a_very_strong_root_password_123456
DB_NAME=ecommerce_db
DB_USER=ecommerce_user
DB_PASSWORD=change_this_to_a_very_strong_user_password_123456

# Redis Credentials
REDIS_PASSWORD=change_this_to_a_very_strong_redis_password_123456

# Volume and Directory Mount Paths (on the host)
# Configuration paths
DB_CONF_PATH=./mariadb/conf
REDIS_CONF_PATH=./redis/conf

# Data storage paths
DB_DATA_PATH=./mariadb/data
REDIS_DATA_PATH=./redis/data

# Log storage paths
DB_LOG_PATH=./mariadb/logs
REDIS_LOG_PATH=./redis/logs
