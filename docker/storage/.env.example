# --- MINIO STORAGE DOCKER ENVIRONMENT ---
# Copy this file to .env and customize values for production deployment

MINIO_VERSION=latest

# Network Port Bindings
MINIO_API_PORT=9000
MINIO_WEB_PORT=9001

# MinIO Credentials (Change these to strong, secure values in production!)
MINIO_ROOT_USER=change_this_to_admin_user
MINIO_ROOT_PASSWORD=change_this_to_a_very_strong_password_123456

# Production External URLs (Update with your domain names or public IPs in production)
MINIO_SERVER_URL=http://localhost:9000
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001

# Host directory for persistent files
# Default to local data directory inside this folder
MINIO_DATA_PATH=./data
