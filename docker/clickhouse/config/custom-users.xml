<clickhouse>
    <profiles>
        <default>
            <!-- Max memory usage per single query. We set it to 4GB. -->
            <max_memory_usage>4294967296</max_memory_usage>

            <!-- Spill data to disk during GROUP BY and JOIN if memory exceeds 2GB (keeps queries from failing) -->
            <max_bytes_before_external_group_by>2147483648</max_bytes_before_external_group_by>
            <max_bytes_before_external_sort>2147483648</max_bytes_before_external_sort>

            <!-- Limit query execution to 5 minutes to prevent hanging or orphaned queries -->
            <max_execution_time>300</max_execution_time>

            <!-- Enable execution of mutations (updates/deletes) asynchronously in background -->
            <mutations_sync>0</mutations_sync>
        </default>
    </profiles>

    <users>
        <!-- The default user will have administrative access and SQL DDL privileges -->
        <default>
            <access_management>1</access_management>
        </default>
    </users>
</clickhouse>
