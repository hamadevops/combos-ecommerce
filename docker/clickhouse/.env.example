# --- CLICKHOUSE DOCKER ENVIRONMENT ---
# Copy this file to .env and customize values for production deployment

CLICKHOUSE_VERSION=24.8-alpine

# Ports configuration (using non-conflicting ports to avoid clashes with other containers)
CLICKHOUSE_HTTP_PORT=8125
CLICKHOUSE_TCP_PORT=9005

# Admin Credentials (Set strong credentials in production!)
CLICKHOUSE_USER=clickhouse_admin
CLICKHOUSE_PASSWORD=change_this_to_a_very_strong_password_123456
CLICKHOUSE_DB=analytics_db

# Persistent Storage Paths on the Host
CLICKHOUSE_DATA_PATH=./data
CLICKHOUSE_LOG_PATH=./logs
