{
  "name": "@projects/backend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "check-types": "tsc --noEmit -p tsconfig.build.json",
    "bundle": "node esbuild.config.js",
    "obfuscate": "node obfuscate.js",
    "build:prod": "pnpm build && pnpm bundle && pnpm obfuscate",
    "build:exe": "pnpm build:prod && pnpm run pack",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "debug": "nest start --debug --watch",
    "start:prod": "node ../../dist/apps/backend/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:up": "mikro-orm migration:up",
    "db:down": "mikro-orm migration:down",
    "db:create": "npx mikro-orm migration:create",
    "mikro-orm": "mikro-orm",
    "seeder": "mikro-orm seeder:run",
    "pack": "pkg . --out-path dist-exe --compress GZip"
  },
  "pkg": {
    "assets": [
      "node_modules/**/*.js",
      "node_modules/**/*.cjs",
      "node_modules/**/*.mjs",
      "node_modules/**/*.json",
      "node_modules/**/*.node",
      "node_modules/**/*.css",
      "node_modules/**/*.html",
      "node_modules/**/*.png",
      "node_modules/**/*.svg",
      "node_modules/**/*.ico",
      "dist/database/migrations/*.js"
    ],
    "targets": [
      "node20-linux-x64"
    ]
  },
  "bin": "dist/main.js",
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@keyv/redis": "^5.1.4",
    "@mikro-orm/core": "6.6.15",
    "@mikro-orm/knex": "6.6.15",
    "@mikro-orm/migrations": "6.6.15",
    "@mikro-orm/mysql": "6.6.15",
    "@mikro-orm/nestjs": "^6.1.1",
    "@mikro-orm/seeder": "6.6.15",
    "@mikro-orm/sql-highlighter": "^1.0.1",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/throttler": "^6.5.0",
    "@projects/shared": "workspace:*",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.65.0",
    "cache-manager": "^7.2.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "compression": "^1.8.1",
    "date-fns": "^3.6.0",
    "dotenv": "^17.2.3",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "joi": "^18.0.2",
    "knex": "3.2.10",
    "minio": "^8.0.6",
    "mysql2": "^3.22.3",
    "nest-winston": "^1.10.2",
    "nodemailer": "^8.0.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5",
    "slugify": "^1.6.6",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@mikro-orm/cli": "6.6.15",
    "@nestjs/cli": "^11.0.14",
    "@nestjs/testing": "^11.0.1",
    "@repo/typescript-config": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.15.3",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.2"
  }
}
