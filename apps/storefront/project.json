{
  "name": "@vibe/storefront",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/storefront",
  "targets": {
    "build": {
      "command": "pnpm run build",
      "options": {
        "cwd": "apps/storefront"
      },
      "outputs": ["{workspaceRoot}/dist/apps/storefront/.next"]
    },
    "serve": {
      "command": "pnpm run dev",
      "options": {
        "cwd": "apps/storefront"
      }
    },
    "start": {
      "command": "next start",
      "options": {
        "cwd": "apps/storefront"
      }
    },
    "lint": {
      "command": "eslint .",
      "options": {
        "cwd": "apps/storefront"
      }
    }
  }
}
