{
  "compilerOptions": {
    "skipLibCheck": true,
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@projects/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@projects/backend/*": [
        "../../apps/backend/src/*"
      ],
      "@projects/admin/*": [
        "../../apps/admin/src/*"
      ],
      "next": [
        "./node_modules/next"
      ],
      "next/*": [
        "./node_modules/next/*"
      ]
    },
    "target": "ES2017"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "../../dist/apps/client/.next/types/**/*.ts",
    "../../dist/apps/client/.next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "backup",
    "vitest.config.ts"
  ]
}
